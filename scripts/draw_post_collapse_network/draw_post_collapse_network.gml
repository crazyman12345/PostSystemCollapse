function draw_post_collapse_network(_x, _y)
{
	draw_set_font(fnt_ascii);
    var ascii_art = [
        @" _______    ______    ______  ________         ______  __      __   ______  ________  ________  __       __       ",
        @"|       \  /      \  /      \|        \       /      \|  \    /  \ /      \|        \|        \|  \     /  \      ",
        @"| $$$$$$$\|  $$$$$$\|  $$$$$$\\$$$$$$$$      |  $$$$$$\\$$\  /  $$|  $$$$$$\\$$$$$$$$| $$$$$$$$| $$\   /  $$      ",
        @"| $$__/ $$| $$  | $$| $$___\$$  | $$         | $$___\$$ \$$\/  $$ | $$___\$$  | $$   | $$__    | $$$\ /  $$$      ",
        @"| $$    $$| $$  | $$ \$$    \   | $$          \$$    \   \$$  $$   \$$    \   | $$   | $$  \   | $$$$\  $$$$      ",
        @"| $$$$$$$ | $$  | $$ _\$$$$$$\  | $$          _\$$$$$$\   \$$$$    _\$$$$$$\  | $$   | $$$$$   | $$\$$ $$ $$      ",
        @"| $$      | $$__/ $$|  \__| $$  | $$         |  \__| $$   | $$    |  \__| $$  | $$   | $$_____ | $$ \$$$| $$      ",
        @"| $$       \$$    $$ \$$    $$  | $$          \$$    $$   | $$     \$$    $$  | $$   | $$     \| $$  \$ | $$      ",
        @" \$$        \$$$$$$   \$$$$$$    \$$           \$$$$$$     \$$      \$$$$$$    \$$    \$$$$$$$$ \$$      \$$      ",
        @"",
        @"",
        @"",
        @"              ______    ______   __        __         ______   _______    ______   ________                       ",
        @"             /      \  /      \ |  \      |  \       /      \ |       \  /      \ |        \                      ",
        @"            |  $$$$$$\|  $$$$$$\| $$      | $$      |  $$$$$$\| $$$$$$$\|  $$$$$$\| $$$$$$$$                      ",
        @"            | $$   \$$| $$  | $$| $$      | $$      | $$__| $$| $$__/ $$| $$___\$$| $$__                          ",
        @"            | $$      | $$  | $$| $$      | $$      | $$    $$| $$    $$ \$$    \ | $$  \                         ",
        @"            | $$   __ | $$  | $$| $$      | $$      | $$$$$$$$| $$$$$$$  _\$$$$$$\| $$$$$                         ",
        @"            | $$__/  \| $$__/ $$| $$_____ | $$_____ | $$  | $$| $$      |  \__| $$| $$_____                       ",
        @"             \$$    $$ \$$    $$| $$     \| $$     \| $$  | $$| $$       \$$    $$| $$     \                      ",
        @"              \$$$$$$   \$$$$$$  \$$$$$$$$ \$$$$$$$$ \$$   \$$ \$$        \$$$$$$  \$$$$$$$$"
    ];

    var line_height = 12;

    for (var i = 0; i < array_length(ascii_art); i++)
    {
        draw_text(
            _x,
            _y + (i * line_height),
            ascii_art[i]
        );
    }
	draw_set_font(fnt_terminal);
}
