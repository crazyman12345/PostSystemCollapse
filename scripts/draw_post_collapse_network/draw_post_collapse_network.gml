function draw_post_collapse_network(_x, _y)
{
	draw_set_font(fnt_ascii);
    var ascii_art = [
        @" ____  ____  ____ _____    ____ ____  _     _     ____  ____  ____  _____   _      _____ _____ _      ____  ____  _  __",
        @"/  __\/  _ \/ ___Y__ __\  /   _Y  _ \/ \   / \   /  _ \/  __\/ ___\/  __/  / \  /|/  __//__ __Y \  /|/  _ \/  __\/ |/ /",
        @"|  \/|| / \||    \ / \    |  / | / \|| |   | |   | / \||  \/||    \|  \    | |\ |||  \    / \ | |  ||| / \||  \/||   / ",
        @"|  __/| \_/|\___ | | |    |  \_| \_/|| |_/\| |_/\| |-|||  __/\___ ||  /_   | | \|||  /_   | | | |/\||| \_/||    /|   \ ",
        @"\_/   \____/\____/ \_/    \____|____/\____/\____/\_/ \|\_/   \____/\____\  \_/  \|\____\  \_/ \_/  \|\____/\_/\_\\_|\_\"
    ];

    var line_height = 14;

    for (var i = 0; i < array_length(ascii_art); i++)
    {
        draw_text(
            _x,
            _y + (i * line_height),
            ascii_art[i]
        );
    }
	draw_set_font(fnt_terminal);
}